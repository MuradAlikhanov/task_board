# ============================================================================
# Task Board — переменные окружения
# Скопируйте в .env и заполните значениями. См. ARCHITECTURE.md §6.
# ============================================================================

# === Окружение ===
# development | production. В production отключается DEV_AUTH_TOKEN и /docs.
APP_ENV=development

# Публичный домен сервиса (для Caddy/TLS и Telegram webhook).
# Локально можно указать localhost.
DOMAIN=localhost
# HSTS max-age в секундах (передаётся в Caddy). Для localhost/self-signed dev — 0
# (отменяет HSTS), для production — 31536000.
HSTS_MAX_AGE=0

# === Vault и БД ===
# UID/GID пользователя хоста, владеющего файлами vault (для docker-compose user:).
# Должен совпадать с пользователем, под которым работает Syncthing/Obsidian.
UID=1000
GID=1000
# Путь к vault внутри контейнера (примонтирован как volume).
VAULT_PATH=/app/vault
# Абсолютный путь к SQLite-индексу внутри контейнера. Индекс лежит ВНЕ vault
# (ARCHITECTURE §7), чтобы Syncthing его не синхронизировал. В Docker compose
# всё равно переопределяет VAULT_PATH и DB_PATH.
DB_PATH=/app/db/index.sqlite

# === Авторизация (этап 2) ===
# Секрет для подписи JWT. В production — длинная случайная строка (openssl rand -hex 32);
# запуск с плейсхолдером 'change-me*' в production запрещён валидатором конфига.
JWT_SECRET=
# Сквозной TTL access-токена (минуты).
JWT_ACCESS_TTL_MINUTES=30
# TTL refresh-токена (дни).
JWT_REFRESH_TTL_DAYS=14

# Статический токен для локальной отладки БЕЗ Telegram Login.
# Работает ТОЛЬКО при APP_ENV != production (см. ARCHITECTURE §6.2).
# POST /api/v1/auth/dev-token с заголовком Authorization: Bearer <DEV_AUTH_TOKEN>.
DEV_AUTH_TOKEN=dev-token-change-me

# === Telegram-бот ===
# Получить у @BotFather (/newbot). Обязателен для этапа 2+.
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Режим получения апдейтов: webhook (прод) | polling (локальный dev). См. ARCHITECTURE §10 Q-A4.
BOT_MODE=polling
# URL вебхука (используется только при BOT_MODE=webhook).
BOT_WEBHOOK_URL=https://${DOMAIN}/bot/webhook

# === Gemini API (embedding + транскрипция) — этап 5/7 ===
# Ключ Google AI API. См. ARCHITECTURE §10 Q-A2, Q-A3.
GEMINI_API_KEY=

# === CORS ===
# Разрешённые origin'ы (через запятую). Для dev — браузер + TMA.
CORS_ORIGINS=http://localhost:3000,https://web.telegram.org

# === API-ключи для ИИ-агентов / интеграций (этап 7) ===
# per-интеграция, полный доступ (Q-P4). Здесь — начальный ключ при первом запуске (опц.).
API_KEYS=

# === Логирование ===
# Уровень логов (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO
